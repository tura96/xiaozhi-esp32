# ESP32-C3 SuperMini: single core RISC-V 160MHz, 4 MB flash, no PSRAM.
# Load last, after sdkconfig.defaults.

CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP32C3_REV_MIN_3=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# 4 MB Flash DIO @ 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom 4 MB partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Button on GPIO 0 (BOOT button / Key 1)
CONFIG_HOMEHUB_BUTTON_GPIO=0

# No addressable LED on GPIO 27 (C5 DevKit default)
CONFIG_HOMEHUB_LED_BACKEND_DEVKIT_GPIO27=n
CONFIG_HOMEHUB_LED_BACKEND_NONE=y

# Advertise as MuseGadget-Charm-XXXXXX
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Charm"

# No PSRAM configuration: trim TLS, Wi-Fi, and BLE buffers to fit internal SRAM
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# Disable home-network tunnel to save SRAM for Noise control session
CONFIG_HOMEHUB_TUNNEL=n

# Trim Wi-Fi and LWIP buffers
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# Trim NimBLE memory pool
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15

# Muse Gadget SDK Token
CONFIG_GADGET_SDK_TOKEN="mgst_SAANO7Mk5jSVGeloaH_VAeveyE-noAxjk9HRakdHgLk"
