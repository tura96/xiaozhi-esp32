{
    "type": "esp32c3-supermini",
    "target": "esp32c3",
    "builds": [
        {
            "name": "esp32c3-supermini",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/4m.csv\"",
                "CONFIG_OLED_SSD1306_128X64=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_USE_ESP_WAKE_WORD=n"
            ]
        },
        {
            "name": "esp32c3-supermini-16m",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_c3.csv\"",
                "CONFIG_OLED_SSD1306_128X64=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_USE_ESP_WAKE_WORD=y"
            ]
        }
    ]
}
